{
  "name": "@rfice/stomp",
  "version": "1.0.6",
  "description": "STOMP WebSocket client library with React integration",
  "type": "module",
  "main": "dist/index.js",
  "module": "dist/index.es.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "import": "./dist/index.es.js",
      "require": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "build:lib": "vite build --mode lib",
    "preview": "vite preview",
    "type-check": "tsc --noEmit",
    "release": "standard-version"
  },
  "keywords": [
    "stomp",
    "websocket",
    "react",
    "typescript",
    "rfice"
  ],
  "author": "R-Support",
  "license": "MIT",
  "peerDependencies": {
    "react": ">=16.8.0",
    "react-dom": ">=16.8.0"
  },
  "dependencies": {
    "@stomp/stompjs": "^7.2.0",
    "rxjs": "^7.8.2"
  },
  "devDependencies": {
    "@types/react": "^18.0.17",
    "@types/react-dom": "^18.0.6",
    "@vitejs/plugin-react": "^5.0.4",
    "standard-version": "^9.5.0",
    "typescript": "^4.6.4",
    "vite": "^7.1.7",
    "vite-plugin-dts": "^4.5.4"
  }
}
